/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * nRF9151 DK application image.
 *
 * The flash layout is shared with the MCUboot image (see sysbuild.cmake and
 * nrf9151dk_flash_partitions.dtsi). Two things it changes from the board default,
 * both explained in oscore_flash_layout.h: the secure/non-secure boundary inside
 * slot0 moves down so TF-M's full profile fits, and slot1 moves to the external
 * SPI NOR chip so the application gets 704 KB instead of 256 KB.
 *
 * The SRAM split is the board's stock 88 KB secure / 168 KB non-secure, which
 * this app already runs with.
 */

#include "nrf9151dk_flash_partitions.dtsi"
